#!/usr/bin/env bash
# wst-tmux-split — split-pane helper that opens in the current stream.
# Bound from dot_tmux.conf.tmpl to `bind '"'` and `bind '%'`.
# Argument: h (horizontal) | v (vertical)

set -euo pipefail

flag="-v"
[[ "${1:-}" = h ]] && flag="-h"

dir=$(tmux show-options -wqv @wst-workdir 2>/dev/null || true)
project=$(tmux show-options -wqv @wst-project 2>/dev/null || true)
stream=$(tmux show-options -wqv @wst-stream 2>/dev/null || true)
port=$(tmux show-options -wqv @wst-port 2>/dev/null || true)
cdp_port=$(tmux show-options -wqv @wst-cdp-port 2>/dev/null || true)
if [[ -z "$cdp_port" && "$port" =~ ^[0-9]+$ ]]; then
  cdp_port="$((port + 10000))"
fi
cdp_port="${cdp_port:-9222}"

if [[ -n "$dir" && -d "$dir" ]]; then
  printf -v command 'env WST_PROJECT=%q WST_STREAM=%q WST_PORT=%q WST_HOST_PORT=%q WST_CDP_PORT=%q WST_BROWSER_PROFILE=%q zsh -l' \
    "$project" "$stream" "$port" "$port" "$cdp_port" "$HOME/.config/chromium-wst"
  pane=$(tmux split-window -P -F '#{pane_id}' "$flag" -c "$dir" "$command")
  "$HOME/.local/bin/wst" resource-pane "$pane" shell
else
  tmux split-window "$flag"
fi
