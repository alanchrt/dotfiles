#!/usr/bin/env bash
# wst — workstream manager: parallel AI-coding streams via independent clones + tmux.
# See: dot_codex/AGENTS.md "Workstream Workflow" and dot_local/share/wst/README.md.

set -euo pipefail

PROJECTS_ROOT="${WST_PROJECTS_ROOT:-$HOME/Projects}"
STATE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/wst"
PORTS_FILE="$STATE_DIR/ports.json"
DEFAULT_PORT_RANGE_LO=13000
DEFAULT_PORT_RANGE_HI=13999

mkdir -p "$STATE_DIR"

die() { printf 'wst: %s\n' "$*" >&2; exit 1; }
warn() { printf 'wst: %s\n' "$*" >&2; }
info() { printf '==> %s\n' "$*"; }
debug() {
  [[ -n "${WST_DEBUG:-}" ]] || return 0
  printf 'wst debug: %s\n' "$*" >&2
}

have() { command -v "$1" >/dev/null 2>&1; }

ui_color() {
  local code="$1"
  [[ -t 1 && -z "${NO_COLOR:-}" ]] && printf '\033[%sm' "$code"
  # Always succeed: callers like `ui_cyan` are invoked as bare statements, and a
  # non-zero return (when stdout isn't a TTY, so the printf is skipped) would
  # trip `set -e` and abort non-interactive runs (e.g. detached `wst new`).
  return 0
}

ui_reset() { ui_color 0; }
ui_dim() { ui_color 2; }
ui_green() { ui_color '1;32'; }
ui_red() { ui_color '1;31'; }
ui_cyan() { ui_color '1;36'; }

ui_step() {
  local label="$1"
  shift

  local log_dir="${WST_STEP_LOG_DIR:-}"
  if [[ -z "$log_dir" ]]; then
    log_dir=$(mktemp -d "${TMPDIR:-/tmp}/wst.XXXXXX")
    WST_STEP_LOG_DIR="$log_dir"
  fi
  mkdir -p "$log_dir"

  local log="$log_dir/$(slugify "$label").log"
  local interactive=false
  [[ -t 1 && -z "${WST_PLAIN_LOGS:-}" ]] && interactive=true

  if [[ -n "${WST_DEBUG:-}" ]]; then
    info "$label"
    debug "command: $*"
    "$@"
    return
  fi

  if ! $interactive; then
    info "$label"
    "$@"
    return
  fi

  local frames=("⠋" "⠙" "⠹" "⠸" "⠼" "⠴" "⠦" "⠧" "⠇" "⠏")
  local i=0 pid status
  "$@" >"$log" 2>&1 &
  pid=$!

  while kill -0 "$pid" 2>/dev/null; do
    printf '\r\033[K  '
    ui_cyan
    printf '%s' "${frames[i % ${#frames[@]}]}"
    ui_reset
    printf ' %s' "$label"
    i=$((i + 1))
    sleep 0.12
  done

  if wait "$pid"; then
    printf '\r\033[K  '
    ui_green
    printf '✓'
    ui_reset
    printf ' %s\n' "$label"
    return 0
  else
    status=$?
  fi

  printf '\r\033[K  '
  ui_red
  printf '✕'
  ui_reset
  printf ' %s\n\n' "$label"
  printf 'stream: %s failed; full log follows from %s\n\n' "$label" "$log" >&2
  cat "$log" >&2
  return "$status"
}

require_tool() {
  have "$1" || die "$1 not found on PATH. Install it first (see roles/$2/)."
}

# ---- project / stream resolution ----

slugify() {
  printf '%s' "$1" | tr '/' '-' | tr -c 'A-Za-z0-9._-' '-'
}

session_name() {
  printf '%s' "$1" | sed -r 's/\./_/g'
}

emacs_daemon_name() {
  printf 'wst-%s-%s' "$(slugify "$1")" "$(slugify "$2")"
}

# Resolve the project directory (~/Projects/<project>/) from cwd or --project flag.
# Echoes the project name on stdout.
resolve_project() {
  local explicit="${1:-}"
  if [[ -n "$explicit" ]]; then
    [[ -d "$PROJECTS_ROOT/$explicit" ]] || die "Project '$explicit' not found at $PROJECTS_ROOT/$explicit"
    printf '%s' "$explicit"
    return
  fi
  local pwd_abs
  pwd_abs=$(realpath "$PWD")
  local prefix="$PROJECTS_ROOT/"
  case "$pwd_abs" in
    "$prefix"*)
      local rel="${pwd_abs#"$prefix"}"
      printf '%s' "${rel%%/*}"
      ;;
    *)
      die "Not inside $PROJECTS_ROOT — pass --project <name> or cd into a project."
      ;;
  esac
}

canonical_dir() {
  printf '%s/%s/main' "$PROJECTS_ROOT" "$1"
}

stream_dir() {
  printf '%s/%s/%s' "$PROJECTS_ROOT" "$1" "$2"
}

stream_purpose() {
  local target="$1"
  git -C "$target" config --get wst.purpose 2>/dev/null || true
}

set_stream_purpose() {
  local target="$1" purpose="$2"
  git -C "$target" config --local wst.purpose "$purpose"
}

stream_developer_instructions() {
  local proj="$1" branch="$2" target="$3"
  local purpose
  purpose=$(stream_purpose "$target")
  if [[ -z "$purpose" ]]; then
    purpose="Use this stream for work that matches its name: $branch."
  fi
  printf '%s' "You are working in the $proj/$branch WST stream. Its durable purpose is: $purpose Keep work aligned with this purpose unless the user explicitly directs otherwise. The user can start each distinct task with /new or /clear; never depend on earlier chat history to remember the stream purpose."
}

write_stream_codex_config() {
  local target="$1" instructions="$2"
  require_tool jq core
  local config_dir="$target/.codex"
  local config_file="$config_dir/config.toml"
  local marker="# Managed by wst — local stream purpose; do not commit."

  if git -C "$target" ls-files --error-unmatch .codex/config.toml >/dev/null 2>&1; then
    warn "not injecting the WST purpose: .codex/config.toml is tracked by the project"
    return 0
  fi
  if [[ -e "$config_file" ]] && ! grep -qxF "$marker" "$config_file"; then
    warn "not injecting the WST purpose: $config_file is not managed by wst"
    return 0
  fi

  local tmp
  mkdir -p "$config_dir"
  tmp=$(mktemp "$config_dir/.config.toml.XXXXXX")
  printf '%s\ndeveloper_instructions = %s\n' \
    "$marker" "$(printf '%s' "$instructions" | jq -Rs .)" > "$tmp"
  chmod 600 "$tmp"
  mv "$tmp" "$config_file"

  local exclude_file="$target/.git/info/exclude"
  grep -qxF '.codex/config.toml' "$exclude_file" 2>/dev/null || \
    printf '%s\n' '.codex/config.toml' >> "$exclude_file"
}

cdp_port_for_host_port() {
  local host_port="$1"
  if [[ "$host_port" =~ ^[0-9]+$ ]]; then
    printf '%s' "$((host_port + 10000))"
  else
    printf '9222'
  fi
}

# tmux creates each pane in its own systemd scope. Keep background workstreams
# below desktop apps for CPU/IO scheduling, and cap runaway agents, language
# servers, and builds before they can force a machine-wide OOM.
resource_policy_for_class() {
  case "$1" in
    agent)  printf '6G\t10G' ;;
    editor) printf '3G\t5G' ;;
    shell)  printf '8G\t12G' ;;
    *)      die "unknown WST resource class '$1'" ;;
  esac
}

resource_unit_for_pane() {
  local pane="$1" pid unit=""
  pid=$(tmux display-message -p -t "$pane" '#{pane_pid}' 2>/dev/null || true)
  [[ -n "$pid" ]] || return 1
  for _ in {1..10}; do
    unit=$(systemctl --user whoami "$pid" 2>/dev/null || true)
    [[ "$unit" == *.scope ]] && { printf '%s' "$unit"; return 0; }
    sleep 0.05
  done
  return 1
}

resource_apply_to_pane() {
  local pane="$1" class="$2" policy high max unit
  [[ -n "$pane" ]] || return 0
  policy=$(resource_policy_for_class "$class")
  IFS=$'\t' read -r high max <<<"$policy"
  unit=$(resource_unit_for_pane "$pane") || {
    warn "could not find the systemd scope for pane $pane; resource limits were not applied"
    return 0
  }
  if ! systemctl --user set-property --runtime "$unit" \
      CPUWeight=25 IOWeight=25 MemoryHigh="$high" MemoryMax="$max" >/dev/null; then
    warn "could not apply resource limits to $pane ($unit)"
  fi
}

resource_class_for_pane() {
  local pane="$1" agent="$2" git="$3"
  if [[ "$pane" == "$agent" ]]; then
    printf 'agent'
  elif [[ -n "$git" && "$pane" == "$git" ]]; then
    printf 'editor'
  else
    printf 'shell'
  fi
}

format_resource_bytes() {
  local value="$1"
  if [[ "$value" =~ ^[0-9]+$ ]]; then
    numfmt --to=iec-i --suffix=B "$value"
  elif [[ "$value" == "infinity" ]]; then
    printf 'inf'
  else
    printf '-'
  fi
}

# Called by wst-tmux-split after tmux has assigned the new pane a systemd scope.
cmd_resource_pane() {
  [[ $# -eq 2 ]] || die "usage: wst resource-pane <pane-id> <agent|editor|shell>"
  resource_apply_to_pane "$1" "$2"
}

stream_command() {
  local proj="$1" branch="$2" host_port="$3" inner="$4"
  local cdp_port; cdp_port=$(cdp_port_for_host_port "$host_port")
  printf 'env WST_PROJECT=%q WST_STREAM=%q WST_PORT=%q WST_HOST_PORT=%q WST_CDP_PORT=%q WST_BROWSER_PROFILE=%q zsh -l -c %q' \
    "$proj" "$branch" "$host_port" "$host_port" "$cdp_port" "$HOME/.config/chromium-wst" "$inner"
}

agent_stream_command() {
  local proj="$1" branch="$2" host_port="$3" inner
  printf -v inner '%q codex; exec zsh -l' "$HOME/.local/bin/wst"
  stream_command "$proj" "$branch" "$host_port" "$inner"
}

# Existing tmux windows survive across attaches. If Codex exited during an
# earlier startup, the agent pane used to remain at a plain shell forever
# because attach only selected the existing window. Restart only an idle zsh
# pane: a running Codex (or any other foreground/background child) is left
# untouched.
tmux_ensure_agent_pane() {
  local proj="$1" branch="$2" slug="$3" target="$4" host_port="$5"
  local session agent_pane pane_pid pane_command agent_command
  session=$(session_name "$proj")
  agent_pane=$(tmux show-options -wqv -t "$session:$slug" @wst-agent-pane 2>/dev/null || true)
  [[ -n "$agent_pane" ]] || return 0

  pane_pid=$(tmux display-message -p -t "$agent_pane" '#{pane_pid}' 2>/dev/null || true)
  pane_command=$(tmux display-message -p -t "$agent_pane" '#{pane_current_command}' 2>/dev/null || true)
  [[ -n "$pane_pid" && "$pane_command" == "zsh" ]] || return 0
  if pgrep -P "$pane_pid" >/dev/null 2>&1; then
    return 0
  fi

  debug "restarting Codex in idle agent pane $agent_pane"
  agent_command=$(agent_stream_command "$proj" "$branch" "$host_port")
  tmux respawn-pane -k -t "$agent_pane" -c "$target" "$agent_command"
}

# ---- port allocation ----

ports_init() {
  require_tool jq core
  [[ -s "$PORTS_FILE" ]] && return
  cat > "$PORTS_FILE" <<EOF
{"range": [$DEFAULT_PORT_RANGE_LO, $DEFAULT_PORT_RANGE_HI], "assignments": {}}
EOF
}

# Look up the port for a stream key (project/slug). Empty if unassigned.
port_get() {
  ports_init
  jq -r --arg k "$1" '.assignments[$k] // empty' "$PORTS_FILE"
}

# Allocate and persist the lowest-unused port for a stream key.
port_allocate() {
  ports_init
  local key="$1"
  local existing
  existing=$(port_get "$key")
  if [[ -n "$existing" ]]; then
    printf '%s' "$existing"
    return
  fi
  local lo hi
  lo=$(jq -r '.range[0]' "$PORTS_FILE")
  hi=$(jq -r '.range[1]' "$PORTS_FILE")
  local used
  used=$(jq -r '.assignments[]' "$PORTS_FILE" | sort -n)
  local p
  for ((p=lo; p<=hi; p++)); do
    if ! grep -qx "$p" <<<"$used"; then
      local tmp="$PORTS_FILE.tmp"
      jq --arg k "$key" --argjson v "$p" '.assignments[$k] = $v' "$PORTS_FILE" > "$tmp"
      mv "$tmp" "$PORTS_FILE"
      printf '%s' "$p"
      return
    fi
  done
  die "port range $lo-$hi exhausted (edit $PORTS_FILE to widen)"
}

port_free() {
  ports_init
  local tmp="$PORTS_FILE.tmp"
  jq --arg k "$1" 'del(.assignments[$k])' "$PORTS_FILE" > "$tmp"
  mv "$tmp" "$PORTS_FILE"
}

# ---- subcommand: clone ----

cmd_clone() {
  local url="${1:-}" name="${2:-}"
  [[ -n "$url" ]] || die "usage: wst clone <git-url> [project-name]"
  if [[ -z "$name" ]]; then
    name=$(basename "$url" .git)
  fi
  local target="$PROJECTS_ROOT/$name"
  [[ ! -e "$target" ]] || die "$target already exists"
  info "Cloning $url → $target/main"
  mkdir -p "$target"
  git clone "$url" "$target/main"
  info "Project laid out at $target/main"
  cat <<EOF

Next steps:
  cd $target/main
  wst new <branch> [--base main]   # create a stream
EOF
}

# ---- subcommand: new ----

cmd_new() {
  local branch="" base="" project="" purpose=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --base)    base="$2"; shift 2 ;;
      --project) project="$2"; shift 2 ;;
      --purpose) purpose="$2"; shift 2 ;;
      --debug)   WST_DEBUG=1; WST_PLAIN_LOGS=1; shift ;;
      -*)        die "unknown flag: $1" ;;
      *)         [[ -z "$branch" ]] && branch="$1" || die "unexpected arg: $1"; shift ;;
    esac
  done
  [[ -n "$branch" ]] || die "usage: wst new <branch> [--base <base>] [--project <name>] [--purpose <text>] [--debug]"
  local proj; proj=$(resolve_project "$project")
  local canonical; canonical=$(canonical_dir "$proj")
  [[ -d "$canonical/.git" ]] || die "canonical '$canonical' is not a git repo (run: wst migrate)"

  local slug; slug=$(slugify "$branch")
  local target; target=$(stream_dir "$proj" "$slug")
  [[ ! -e "$target" ]] || die "stream dir $target already exists — use: wst attach $branch"

  # Resolve base if unset: origin/HEAD short name → fallback to current canonical branch
  if [[ -z "$base" ]]; then
    base=$(git -C "$canonical" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's|^origin/||' || true)
    [[ -n "$base" ]] || base=$(git -C "$canonical" branch --show-current)
  fi
  debug "project=$proj"
  debug "branch=$branch"
  debug "slug=$slug"
  debug "base=$base"
  debug "canonical=$canonical"
  debug "target=$target"

  local WST_STEP_LOG_DIR
  WST_STEP_LOG_DIR=$(mktemp -d "${TMPDIR:-/tmp}/wst-new.XXXXXX")
  debug "step_log_dir=$WST_STEP_LOG_DIR"

  ui_cyan
  printf 'Creating stream'
  ui_reset
  printf ' %s/%s\n\n' "$proj" "$branch"

  ui_step "Clone stream" git clone --local "$canonical" "$target"
  ui_step "Sync $base from origin (agent will branch as $branch)" cmd_new_checkout "$canonical" "$target" "$base" "$branch"
  if [[ -n "$purpose" ]]; then
    set_stream_purpose "$target" "$purpose"
  fi

  local key="$proj/$slug"
  local host_port
  host_port=$(port_allocate "$key")
  [[ ! -t 1 || -n "${WST_PLAIN_LOGS:-}" ]] && info "Allocated host port $host_port for $key"
  debug "host_port=$host_port"
  ui_step "Provision agent tooling" provision_host "$target"

  ui_step "Open tmux workspace" tmux_create_window "$proj" "$branch" "$slug" "$target" "$host_port"
  rm -rf "$WST_STEP_LOG_DIR"

  cat <<EOF

Stream '$branch' ready (on '$base', synced to origin).
  Workdir : $target
  Preview : http://localhost:$host_port/
  Attach  : wa $branch
  Note    : agent creates branch '$branch' on first commit — commits on '$base' are blocked.
EOF
}

# ---- subcommands: purpose / codex ----

current_stream_context() {
  local target
  target=$(git rev-parse --show-toplevel 2>/dev/null) || die "not inside a git worktree"

  local branch
  branch=$(git -C "$target" config --get wst.branch 2>/dev/null || true)
  branch="${WST_STREAM:-${branch:-$(basename "$target")}}"

  local proj
  proj="${WST_PROJECT:-$(basename "$(dirname "$target")")}"

  printf '%s\t%s\t%s' "$proj" "$branch" "$target"
}

cmd_purpose() {
  local context proj branch target
  context=$(current_stream_context)
  IFS=$'\t' read -r proj branch target <<<"$context"

  case "${1:-}" in
    "")
      local purpose
      purpose=$(stream_purpose "$target")
      if [[ -n "$purpose" ]]; then
        printf '%s\n' "$purpose"
      else
        printf 'Use this stream for work that matches its name: %s.\n' "$branch"
      fi
      ;;
    --set)
      shift
      [[ $# -gt 0 ]] || die "usage: wst purpose --set <text>"
      local purpose="$*"
      set_stream_purpose "$target" "$purpose"
      printf 'Saved purpose for %s/%s:\n%s\n\n' "$proj" "$branch" "$purpose"
      printf 'Restart the current Codex CLI once with /quit, then run: wst codex\n'
      ;;
    --clear)
      [[ $# -eq 1 ]] || die "usage: wst purpose --clear"
      git -C "$target" config --local --unset-all wst.purpose 2>/dev/null || true
      printf 'Cleared the explicit purpose for %s/%s. The stream name is now the fallback.\n' "$proj" "$branch"
      ;;
    *)
      die "usage: wst purpose [--set <text> | --clear]"
      ;;
  esac
}

cmd_codex() {
  local context proj branch target instructions
  context=$(current_stream_context)
  IFS=$'\t' read -r proj branch target <<<"$context"
  instructions=$(stream_developer_instructions "$proj" "$branch" "$target")
  write_stream_codex_config "$target" "$instructions"
  exec codex "$@"
}

# The stream opens *on the trunk* (e.g. main) reset to origin/<base>, NOT on a
# pre-created feature branch. The agent can initialize either a normal branch or
# a native GitHub stack when work begins. The intended branch name is recorded in
# git config (wst.branch) and a pre-commit guard blocks commits made on the trunk.
cmd_new_checkout() {
  local canonical="$1" target="$2" base="$3" branch="$4"
  local origin_url
  origin_url=$(git -C "$canonical" remote get-url origin)
  git -C "$target" remote set-url origin "$origin_url"
  git -C "$target" fetch origin
  git -C "$target" checkout -B "$base" "origin/$base"
  git -C "$target" branch --set-upstream-to "origin/$base" "$base" 2>/dev/null || true
  git -C "$target" config wst.branch "$branch"   # branch the agent should create
  git -C "$target" config wst.trunk  "$base"     # trunk the commit guard protects
  install_trunk_commit_guard "$target"
}

# Install a pre-commit hook that refuses commits made while HEAD is the trunk.
# Streams open on the trunk (see cmd_new_checkout); this enforces that agents
# branch before committing rather than landing work on main/master. The hook is
# local to the stream's .git (git clone --local does not copy hooks), so writing
# it is an idempotent overwrite. `--no-verify` remains an escape hatch.
install_trunk_commit_guard() {
  local target="$1"
  local hook="$target/.git/hooks/pre-commit"
  mkdir -p "$target/.git/hooks"
  cat > "$hook" <<'HOOK'
#!/usr/bin/env bash
# Managed by wst — blocks commits on the trunk so streams branch first.
cur=$(git symbolic-ref --short HEAD 2>/dev/null) || exit 0
trunk=$(git config wst.trunk 2>/dev/null || echo main)
case "$cur" in
  "$trunk"|main|master)
    s=$(git config wst.branch 2>/dev/null); : "${s:=${WST_STREAM:-my-feature}}"
    echo "wst: refusing to commit on trunk '$cur'." >&2
    echo "Create a feature branch first:" >&2
    echo "    git switch -c $s        # single PR" >&2
    echo "    gh stack init $s        # native GitHub stack" >&2
    exit 1 ;;
esac
exit 0
HOOK
  chmod +x "$hook"
}

# ---- subcommand: attach ----

cmd_attach() {
  local branch=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --debug) WST_DEBUG=1; WST_PLAIN_LOGS=1; shift ;;
      -*)      die "unknown flag: $1" ;;
      *)       [[ -z "$branch" ]] && branch="$1" || die "unexpected arg: $1"; shift ;;
    esac
  done
  [[ -n "$branch" ]] || die "usage: wst attach <branch> [--debug]"
  local proj; proj=$(resolve_project)
  local slug; slug=$(slugify "$branch")
  local target; target=$(stream_dir "$proj" "$slug")
  [[ -d "$target" ]] || die "stream '$branch' doesn't exist. Create with: wst new $branch"
  debug "project=$proj"
  debug "branch=$branch"
  debug "slug=$slug"
  debug "target=$target"
  # Self-heal: ensure pre-existing streams gain the trunk commit guard. Resolve
  # the trunk if it was never recorded (older streams), then (re)install the hook.
  if [[ -d "$target/.git" ]]; then
    if [[ -z "$(git -C "$target" config wst.trunk 2>/dev/null || true)" ]]; then
      local trunk
      trunk=$(git -C "$target" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's|^origin/||' || true)
      [[ -n "$trunk" ]] || trunk=$(git -C "$target" branch --show-current)
      [[ -n "$trunk" ]] && git -C "$target" config wst.trunk "$trunk"
    fi
    [[ -z "$(git -C "$target" config wst.branch 2>/dev/null || true)" ]] && \
      git -C "$target" config wst.branch "$branch"
    install_trunk_commit_guard "$target"
  fi

  local session; session=$(session_name "$proj")
  debug "tmux_session=$session"
  if ! tmux has-session -t "$session" 2>/dev/null; then
    debug "creating tmux session $session"
    tmux new-session -d -s "$session" -c "$PROJECTS_ROOT/$proj"
  fi

  # Window may not exist yet — create on first attach after a stream is closed.
  if ! tmux list-windows -t "$session" -F '#{window_name}' 2>/dev/null | grep -qx "$slug"; then
    debug "tmux window $session:$slug missing; creating"
    local key="$proj/$slug"
    local host_port; host_port=$(port_get "$key")
    [[ -n "$host_port" ]] || host_port=$(port_allocate "$key")
    tmux_create_window "$proj" "$branch" "$slug" "$target" "$host_port"
  else
    debug "tmux window $session:$slug exists"
    local key="$proj/$slug"
    local host_port; host_port=$(port_get "$key")
    [[ -n "$host_port" ]] || host_port=$(port_allocate "$key")
    tmux set-option -w -t "$session:$slug" @wst-port "$host_port"
    tmux set-option -w -t "$session:$slug" @wst-cdp-port "$(cdp_port_for_host_port "$host_port")"
    tmux_ensure_agent_pane "$proj" "$branch" "$slug" "$target" "$host_port"
  fi

  if [[ -n "${TMUX:-}" ]]; then
    tmux select-window -t "$session:$slug"
  else
    tmux attach-session -t "$session" \; select-window -t "$session:$slug"
  fi
}

# ---- subcommand: preview ----

cmd_preview() {
  local branch="${1:-}"
  local port=""
  if [[ -z "$branch" ]]; then
    [[ -n "${TMUX:-}" ]] || die "preview needs <branch> outside tmux"
    port=$(tmux show-options -wqv @wst-port 2>/dev/null || true)
    [[ -n "$port" ]] || die "current tmux window is not a stream window (no @wst-port). Pass <branch>."
  else
    local proj; proj=$(resolve_project)
    local slug; slug=$(slugify "$branch")
    port=$(port_get "$proj/$slug")
    [[ -n "$port" ]] || die "no port allocated for $proj/$slug — did wst new run?"
  fi
  local url="http://localhost:$port/"
  printf '%s\n' "$url"
  have xdg-open && xdg-open "$url" >/dev/null 2>&1 || true
}

# ---- subcommand: ls ----

cmd_ls() {
  local all=false
  [[ "${1:-}" == "--all" ]] && all=true
  if $all; then
    for pdir in "$PROJECTS_ROOT"/*/; do
      [[ -d "$pdir" ]] || continue
      local pname; pname=$(basename "$pdir")
      _ls_project "$pname"
    done
  else
    local proj; proj=$(resolve_project)
    _ls_project "$proj"
  fi
}

_ls_project() {
  local proj="$1"
  local any=false
  for sdir in "$PROJECTS_ROOT/$proj"/*/; do
    [[ -d "$sdir/.git" ]] || continue
    local slug; slug=$(basename "$sdir")
    [[ "$slug" == "main" ]] && continue
    local key="$proj/$slug"
    local port; port=$(port_get "$key")
    printf '%s/%s\tport:%s\n' "$proj" "$slug" "${port:-?}"
    any=true
  done
  $any || printf '(no streams in %s)\n' "$proj"
}

# ---- subcommand: resources ----

cmd_resources() {
  local apply=false stream_filter=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --apply) apply=true; shift ;;
      -*) die "unknown flag: $1" ;;
      *)
        [[ -z "$stream_filter" ]] || die "unexpected arg: $1"
        stream_filter="$1"
        shift
        ;;
    esac
  done

  local rows
  rows=$(tmux list-panes -a -F '#{@wst-project}|#{@wst-stream}|#{pane_id}|#{pane_current_command}|#{@wst-agent-pane}|#{@wst-git-pane}' 2>/dev/null || true)
  [[ -n "$rows" ]] || { printf '(no active WST panes)\n'; return 0; }

  printf '%-28s %-7s %-14s %9s %9s %9s %13s %7s\n' \
    STREAM CLASS COMMAND MEMORY SWAP PEAK HIGH/MAX CPU/IO

  local any=false total_memory=0 total_swap=0
  local project stream pane command agent git class unit properties
  while IFS='|' read -r project stream pane command agent git; do
    [[ -n "$project" && -n "$stream" ]] || continue
    if [[ -n "$stream_filter" && "$stream" != "$stream_filter" && "$(slugify "$stream")" != "$(slugify "$stream_filter")" ]]; then
      continue
    fi
    any=true
    class=$(resource_class_for_pane "$pane" "$agent" "$git")
    $apply && resource_apply_to_pane "$pane" "$class"
    unit=$(resource_unit_for_pane "$pane" || true)

    local memory=0 swap=0 peak=0 high="infinity" max="infinity" cpu="-" io="-"
    if [[ -n "$unit" ]]; then
      properties=$(systemctl --user show "$unit" \
        -p MemoryCurrent -p MemorySwapCurrent -p MemoryPeak \
        -p MemoryHigh -p MemoryMax -p CPUWeight -p IOWeight 2>/dev/null || true)
      local key value
      while IFS='=' read -r key value; do
        case "$key" in
          MemoryCurrent) memory="$value" ;;
          MemorySwapCurrent) swap="$value" ;;
          MemoryPeak) peak="$value" ;;
          MemoryHigh) high="$value" ;;
          MemoryMax) max="$value" ;;
          CPUWeight) cpu="$value" ;;
          IOWeight) io="$value" ;;
        esac
      done <<<"$properties"
    fi
    [[ "$memory" =~ ^[0-9]+$ ]] && total_memory=$((total_memory + memory))
    [[ "$swap" =~ ^[0-9]+$ ]] && total_swap=$((total_swap + swap))
    printf '%-28s %-7s %-14.14s %9s %9s %9s %6s/%-6s %3s/%-3s\n' \
      "$project/$stream" "$class" "$command" \
      "$(format_resource_bytes "$memory")" "$(format_resource_bytes "$swap")" \
      "$(format_resource_bytes "$peak")" "$(format_resource_bytes "$high")" \
      "$(format_resource_bytes "$max")" "$cpu" "$io"
  done <<<"$rows"

  $any || { printf '(no matching active WST panes)\n'; return 0; }
  printf '\nTotal active WST pane memory: %s; swap: %s\n' \
    "$(format_resource_bytes "$total_memory")" "$(format_resource_bytes "$total_swap")"
  if $apply; then
    printf 'Applied limits: agent 6G/10G, editor 3G/5G, shell 8G/12G high/max; CPU/IO weight 25.\n'
  fi
}

# ---- subcommand: park ----

cmd_park() {
  local branch="${1:-}"
  [[ -n "$branch" && $# -eq 1 ]] || die "usage: wst park <branch>"
  local proj; proj=$(resolve_project)
  local slug; slug=$(slugify "$branch")
  local target; target=$(stream_dir "$proj" "$slug")
  [[ "$slug" != "main" ]] || die "refuse: 'main' is the canonical, not a stream"
  [[ -d "$target" ]] || die "stream '$branch' does not exist"

  local session; session=$(session_name "$proj")
  local emacs_daemon; emacs_daemon=$(emacs_daemon_name "$proj" "$slug")

  # Stop the daemon before closing the window. Closing the current window also
  # kills this command, so emit the durable-state confirmation first.
  cmd_rm_emacs "$emacs_daemon"
  printf "Parked %s/%s: clone, Git state, and port are preserved. Reopen with: wa %s\n" \
    "$proj" "$branch" "$branch"
  cmd_rm_tmux_window "$session" "$slug"
}

# ---- subcommand: rm ----

cmd_rm() {
  local branch="" force=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --force|-f) force=true; shift ;;
      *)          [[ -z "$branch" ]] && branch="$1" || die "unexpected arg: $1"; shift ;;
    esac
  done
  [[ -n "$branch" ]] || die "usage: wst rm <branch> [--force]"
  local proj; proj=$(resolve_project)
  local slug; slug=$(slugify "$branch")
  local target; target=$(stream_dir "$proj" "$slug")
  [[ "$slug" != "main" ]] || die "refuse: 'main' is the canonical, not a stream"
  [[ -d "$target" ]] || { warn "$target does not exist (already removed?)"; return 0; }

  if ! $force; then
    local unpushed=0 unstaged=0
    if git -C "$target" rev-parse --abbrev-ref '@{upstream}' >/dev/null 2>&1; then
      unpushed=$(git -C "$target" log --oneline '@{upstream}..HEAD' 2>/dev/null | wc -l)
    else
      unpushed=$(git -C "$target" log --oneline 2>/dev/null | wc -l)
    fi
    unstaged=$(git -C "$target" status --porcelain 2>/dev/null | wc -l)
    if (( unpushed > 0 || unstaged > 0 )); then
      warn "stream has $unpushed unpushed / $unstaged unstaged changes — pass --force to remove anyway"
      return 1
    fi
  fi

  local session; session=$(session_name "$proj")

  local emacs_daemon; emacs_daemon=$(emacs_daemon_name "$proj" "$slug")

  local WST_STEP_LOG_DIR
  WST_STEP_LOG_DIR=$(mktemp -d "${TMPDIR:-/tmp}/wst-rm.XXXXXX")

  ui_cyan
  printf 'Removing stream'
  ui_reset
  printf ' %s/%s\n\n' "$proj" "$branch"

  ui_step "Close tmux workspace" cmd_rm_tmux_window "$session" "$slug"
  ui_step "Stop Emacs pane" cmd_rm_emacs "$emacs_daemon"
  ui_step "Remove stream files" rm -rf "$target"
  ui_step "Release port" port_free "$proj/$slug"
  rm -rf "$WST_STEP_LOG_DIR"

  ui_green
  printf '✓'
  ui_reset
  printf ' Removed %s/%s\n' "$proj" "$branch"
}

cmd_rm_tmux_window() {
  local session="$1" slug="$2"
  if tmux has-session -t "$session" 2>/dev/null \
       && tmux list-windows -t "$session" -F '#{window_name}' | grep -qx "$slug"; then
    tmux kill-window -t "$session:$slug"
  fi
}

cmd_rm_emacs() {
  local emacs_daemon="$1"
  if emacsclient -s "$emacs_daemon" --eval t >/dev/null 2>&1; then
    emacsclient -s "$emacs_daemon" --eval '(kill-emacs)' >/dev/null
  fi
}

# ---- subcommand: doctor ----

cmd_doctor() {
  local ok=true
  printf 'Host prerequisites:\n'
  for t in jq tmux git gh; do
    if have "$t"; then
      printf '  %-15s ok\n' "$t"
    else
      printf '  %-15s MISSING\n' "$t"
      ok=false
    fi
  done

  printf '\nProjects layout (%s):\n' "$PROJECTS_ROOT"
  for d in "$PROJECTS_ROOT"/*/; do
    [[ -d "$d" ]] || continue
    local name; name=$(basename "$d")
    if [[ -d "$d/.git" ]]; then
      printf '  %-30s pre-migration layout (needs: wst migrate)\n' "$name"
      ok=false
    elif [[ -d "$d/main/.git" ]]; then
      printf '  %-30s migrated\n' "$name"
    fi
  done

  printf '\nPort assignments:\n'
  ports_init
  jq -r '.assignments | to_entries[] | "  " + .key + " → " + (.value|tostring)' "$PORTS_FILE"

  $ok || exit 1
}

# ---- subcommand: migrate ----

cmd_migrate() {
  exec "$HOME/.local/bin/wst-migrate-canonical" "$@"
}

# ---- helpers ----

provision_host() {
  local target="$1"
  mkdir -p "$HOME/.config/chromium-wst"
  if command -v zsh >/dev/null 2>&1; then
    (cd "$target" && timeout 90 zsh -lic 'true' >/dev/null 2>&1) || true
  fi
}

cmd_chrome() {
  # Open headed Chromium for the current stream against the shared persistent
  # profile. Use this when Codex needs a Chrome DevTools MCP target or
  # asks you to complete SSO / MFA / a captcha —
  # see ~/.local/share/wst/README.md (Browser handoff workflow).
  #
  # Detect the stream via the tmux window option set by tmux_create_window.
  local proj branch target slug session
  proj=$(tmux show-options -wqv @wst-project 2>/dev/null || true)
  branch=$(tmux show-options -wqv @wst-stream 2>/dev/null || true)
  target=$(tmux show-options -wqv @wst-workdir 2>/dev/null || true)
  if [[ -z "$proj" || -z "$branch" || -z "$target" ]]; then
    die "not inside a wst stream tmux window (use \`wa <branch>\` first)"
  fi
  if [[ -z "${WAYLAND_DISPLAY:-}" ]]; then
    warn "WAYLAND_DISPLAY is empty on the host — headed Chromium will fail to connect"
  fi
  local port cdp_port
  port=$(tmux show-options -wqv @wst-port 2>/dev/null || true)
  cdp_port=$(tmux show-options -wqv @wst-cdp-port 2>/dev/null || true)
  cdp_port="${cdp_port:-$(cdp_port_for_host_port "$port")}"
  info "opening headed Chromium for stream $proj/$branch (CDP :$cdp_port)"
  local chrome=""
  for candidate in chromium chromium-browser google-chrome google-chrome-stable; do
    if command -v "$candidate" >/dev/null 2>&1; then
      chrome=$(command -v "$candidate")
      break
    fi
  done
  [[ -n "$chrome" ]] || die "no host Chromium/Chrome binary found on PATH"
  exec "$chrome" \
    --remote-debugging-port="$cdp_port" \
    --user-data-dir="$HOME/.config/chromium-wst" \
    --no-first-run --no-default-browser-check \
    "$@"
}

tmux_create_window() {
  local proj="$1" branch="$2" slug="$3" target="$4" host_port="$5"
  local cdp_port; cdp_port=$(cdp_port_for_host_port "$host_port")
  local session; session=$(session_name "$proj")
  if ! tmux has-session -t "$session" 2>/dev/null; then
    tmux new-session -d -s "$session" -c "$PROJECTS_ROOT/$proj"
  fi
  # Pass the command as the new-window argument so the pane's process IS the
  # stream command — avoids leaving the launch command visible in scrollback.
  # Drop straight into Codex; when it exits, fall back to an interactive login
  # shell so the pane stays usable. Pane splits (wst-tmux-split) still open in
  # zsh, so you can split for shell work.
  local agent_pane=""
  local git_pane=""
  local shell_pane=""
  local agent_command
  agent_command=$(agent_stream_command "$proj" "$branch" "$host_port")
  agent_pane=$(tmux new-window -P -F '#{pane_id}' -t "$session:" -n "$slug" -c "$target" \
    "$agent_command")
  # 3-pane layout: agent (top-left ~60%), spare zsh (top-right ~40%),
  # git UI (bottom, full width, ~33% height). Set WST_PANES=1 to skip
  # the splits and keep the single-pane layout. The default Magit pane
  # runs on the host in a stream-specific Emacs daemon, so it edits host
  # paths without sharing buffers with other streams. Set
  # WST_GIT_PANE=lazygit to use lazygit instead.
  if [[ "${WST_PANES:-}" != 1 ]]; then
    case "${WST_GIT_PANE:-magit}" in
      magit|emacs)
        local emacs_daemon; emacs_daemon=$(emacs_daemon_name "$proj" "$slug")
        local emacs_command
        printf -v emacs_command '%q %q %q %q' \
          "$HOME/.local/bin/wst-emacs-pane" "$emacs_daemon" "$target" "$proj/$branch"
        git_pane=$(tmux split-window -P -F '#{pane_id}' -v -l 33% -t "$agent_pane" -c "$target" \
          "$emacs_command")
        ;;
      lazygit)
        local lazygit_command
        lazygit_command=$(stream_command "$proj" "$branch" "$host_port" 'lazygit; exec zsh -l')
        git_pane=$(tmux split-window -P -F '#{pane_id}' -v -l 33% -t "$agent_pane" -c "$target" \
          "$lazygit_command")
        ;;
      shell|zsh)
        local git_shell_command
        git_shell_command=$(stream_command "$proj" "$branch" "$host_port" 'exec zsh -l')
        git_pane=$(tmux split-window -P -F '#{pane_id}' -v -l 33% -t "$agent_pane" -c "$target" \
          "$git_shell_command")
        ;;
      *)
        die "unknown WST_GIT_PANE='${WST_GIT_PANE}' (expected: magit, lazygit, shell)"
        ;;
    esac
    # 2. Split the captured agent pane horizontally for the spare zsh on the
    # right. Targeting the pane ID keeps placement independent of focus and
    # tmux's pane-base-index setting.
    local shell_command
    shell_command=$(stream_command "$proj" "$branch" "$host_port" 'exec zsh -l')
    shell_pane=$(tmux split-window -P -F '#{pane_id}' -h -l 40% -t "$agent_pane" -c "$target" \
      "$shell_command")
  fi
  tmux set-option -w -t "$session:$slug" @wst-project "$proj"
  tmux set-option -w -t "$session:$slug" @wst-stream  "$branch"
  tmux set-option -w -t "$session:$slug" @wst-workdir "$target"
  tmux set-option -w -t "$session:$slug" @wst-port    "$host_port"
  tmux set-option -w -t "$session:$slug" @wst-cdp-port "$cdp_port"
  tmux set-option -w -t "$session:$slug" @wst-agent-pane "$agent_pane"
  tmux set-option -w -t "$session:$slug" @wst-codex-pane "$agent_pane"
  tmux set-option -w -t "$session:$slug" @wst-git-pane   "$git_pane"
  tmux set-option -w -t "$session:$slug" @wst-shell-pane "$shell_pane"
  resource_apply_to_pane "$agent_pane" agent
  resource_apply_to_pane "$git_pane" editor
  resource_apply_to_pane "$shell_pane" shell
  tmux select-pane -t "$agent_pane"
}

# ---- dispatch ----

usage() {
  cat <<'EOF'
wst — workstream manager

usage:
  wst clone <git-url> [project-name]                    clone repo into ~/Projects/<name>/main/  (alias: wcl)
  wst new <branch> [--base <base>] [--project <name>] [--purpose <text>] [--debug]
                                                          create stream
  wst attach <branch> [--debug]                         switch to stream window                  (alias: wa)
  wst preview [<branch>]                                open localhost:<port>/                   (alias: wp)
  wst ls [--all]                                        list streams                             (alias: wls)
  wst resources [--apply] [<branch>]                    show/apply active pane resource limits
  wst park <branch>                                     stop a workspace but preserve its clone
  wst rm <branch> [--force]                             tear down stream
  wst purpose [--set <text> | --clear]                  view or set the persistent Codex purpose
  wst codex [codex options...]                          start Codex with the stream purpose
  wst chrome [-- <url> ...]                             open headed Chromium for Chrome DevTools MCP
  wst doctor                                            diagnostics
  wst migrate                                           one-shot canonical relocation

env:
  WST_PANES=1                                           single-pane layout (default: codex + magit + zsh)
  WST_DEBUG=1                                           print debug output for new/attach
EOF
}

case "${1:-}" in
  clone)   shift; cmd_clone "$@" ;;
  new)     shift; cmd_new "$@" ;;
  attach)  shift; cmd_attach "$@" ;;
  preview) shift; cmd_preview "$@" ;;
  ls)      shift; cmd_ls "$@" ;;
  resources) shift; cmd_resources "$@" ;;
  resource-pane) shift; cmd_resource_pane "$@" ;;
  park)    shift; cmd_park "$@" ;;
  rm)      shift; cmd_rm "$@" ;;
  purpose) shift; cmd_purpose "$@" ;;
  codex)   shift; cmd_codex "$@" ;;
  chrome)  shift; cmd_chrome "$@" ;;
  doctor)  shift; cmd_doctor "$@" ;;
  migrate) shift; cmd_migrate "$@" ;;
  -h|--help|help|"") usage ;;
  *)       usage; exit 1 ;;
esac
